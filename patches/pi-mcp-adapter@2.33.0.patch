new file mode 100644
index 0000000000000000000000000000000000000000..60bb56ab82f83ac5e8c26fcf8348e996f6583690
--- /dev/null
+++ b/mcp-refresh-lock-helper.cjs
@@ -0,0 +1,12 @@
+'use strict';
+const { tryLock } = require('fs-native-extensions');
+const { setTimeout: delay } = require('node:timers/promises');
+
+// The parent owns fd 3's open description. EOF means it exited or cancelled
+// before acquisition; do not leave an orphan waiting for a discarded request.
+process.stdin.resume();
+process.stdin.once('end', () => process.exit(1));
+(async () => {
+  while (!tryLock(3)) await delay(50 + Math.floor(Math.random() * 50));
+  process.exit(0);
+})().catch(() => process.exit(1));
