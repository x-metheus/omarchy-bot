{
  "name": "omarchy-bot",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "workers/*", "apps/*", "tests/*"],
  "scripts": {
    "dev": "bun run --filter='@omarchy-bot/daemon' --filter='@omarchy-bot/web' dev",
    "start": "bun run --filter='@omarchy-bot/daemon' start",
    "site:dev": "bun run --filter='@omarchy-bot/site' dev",
    "site:build": "bun run --filter='@omarchy-bot/site' build",
    "build": "bun run --filter='*' build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bunx playwright test -c tests/e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@types/bun": "latest",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "26.4.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@types/node": "26.4.0"
  },
  "patchedDependencies": {
    "@astryxdesign/core@0.5.2": "patches/@astryxdesign%2Fcore@0.5.2.patch",
    "pi-mcp-adapter@2.33.0": "patches/pi-mcp-adapter@2.33.0.patch"
  }
}
