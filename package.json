{
  "name": "omarchy-bot",
  "private": true,
  "type": "module",
  "engines": { "bun": "1.4.5" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "tauri": "bun run --cwd apps/omarchy-bot tauri",
    "site:dev": "bun run --filter='@omarchy-bot/site' dev",
    "site:build": "bun run --filter='@omarchy-bot/site' build",
    "build": "bun run --cwd apps/omarchy-bot build:frontend",
    "typecheck": "tsc --noEmit && tsc -p apps/omarchy-bot/tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "26.6.11",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@types/node": "26.6.11"
  }
}
